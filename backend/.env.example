# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
LOG_LEVEL=debug

# ---- Database (PostgreSQL 16 + PostGIS) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=yatrago
DATABASE_PASSWORD=yatrago
DATABASE_NAME=yatrago
DATABASE_SSL=false
# Turn off in prod; migrations are the only schema authority.
DATABASE_LOGGING=false

# ---- Redis (cache, leaderboards, BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# dev = OTP returned in the API response and logged, never sent. Use 'msg91' in staging/prod.
OTP_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Media / object storage (S3 or Cloudflare R2) ----
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=yatrago-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=http://localhost:9000/yatrago-media-dev
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_MAX_BYTES=10485760

# ---- Check-in / verification tuning ----
# Max clock skew between client capture time and server receipt.
CHECKIN_CAPTURE_WINDOW_SECONDS=600
# Extra slack added to a destination geofence to absorb GPS error.
CHECKIN_GPS_ACCURACY_CEILING_M=200
# Above this, we refuse to judge the fix at all and queue for manual review.
CHECKIN_MAX_ACCURACY_M=500
# km/h between consecutive approved check-ins that implies teleportation (flights excluded, see service).
CHECKIN_IMPOSSIBLE_VELOCITY_KMH=900
CHECKIN_PER_DAY_CAP=8
CHECKIN_DESTINATION_COOLDOWN_HOURS=24
PHASH_DISTANCE_THRESHOLD=6
# Trust score at or above which a clean submission auto-approves.
TRUST_AUTO_APPROVE_THRESHOLD=60
# Share of clean auto-approvals pulled into the manual queue as an audit sample.
MODERATION_AUDIT_SAMPLE_RATE=0.05

# ---- Points ----
POINTS_DAILY_CAP=600

# ---- Rate limits ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---- Observability ----
SENTRY_DSN=
