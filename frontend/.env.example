# Where the frontend reads data from.
# Default (unset) = the built-in mock route handlers at /api/v1.
# Point this at Member B's NestJS API to go live — no component changes required.
# NEXT_PUBLIC_API_BASE_URL=https://staging.yatrago.in/v1

# Canonical origin, used for metadata, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps. Defaults to OpenStreetMap raster tiles via MapLibre, which needs no token.
# To use Mapbox instead (PRD §13 preference), set both:
# NEXT_PUBLIC_MAP_STYLE_URL=mapbox://styles/mapbox/outdoors-v12
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxx
